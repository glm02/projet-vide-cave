(version 1)
(rule "Isolation secteur logique 8 mm minimum"
 (condition "(B.NetName == '/GATE' || B.NetName == '/L_ENTREE' || B.NetName == '/L_FUSIBLE' || B.NetName == '/L_POMPE' || B.NetName == '/MT2' || B.NetName == '/N' || B.NetName == '/OPTO_MT2' || B.NetName == '/PE' || B.NetName == '/R_G_SERIE' || B.NetName == '/SNUBBER') && (A.NetName == '/+5V' || A.NetName == '/ADC_I' || A.NetName == '/BASE_NPN' || A.NetName == '/BOUTON_START' || A.NetName == '/BOUTON_STOP' || A.NetName == '/GND' || A.NetName == '/ICSP_CLK' || A.NetName == '/ICSP_DAT' || A.NetName == '/I_BRUT' || A.NetName == '/LCD_A' || A.NetName == '/LCD_D4' || A.NetName == '/LCD_D5' || A.NetName == '/LCD_D6' || A.NetName == '/LCD_D7' || A.NetName == '/LCD_E' || A.NetName == '/LCD_RS' || A.NetName == '/LCD_VO' || A.NetName == '/LED_A' || A.NetName == '/LED_POMPE' || A.NetName == '/MCLR' || A.NetName == '/OPTO_A' || A.NetName == '/OPTO_K' || A.NetName == '/POMPE_CMD' || A.NetName == '/UART_RX' || A.NetName == '/UART_TX')")
 (constraint clearance (min 8mm)))
