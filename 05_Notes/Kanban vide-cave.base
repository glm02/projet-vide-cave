filters:
  and:
    - file.inFolder("05_Notes/Kanban")
properties:
  note.statut:
    displayName: Statut
  note.qui:
    displayName: Qui
  note.partie:
    displayName: Partie
  note.etape:
    displayName: Étape
  note.duree:
    displayName: Heures
  note.date:
    displayName: Lundi
views:
  - type: kanban-view
    name: Par étape
    order:
      - qui
      - duree
      - date
    groupByProperty: note.statut
    swimlaneByProperty: note.etape
    columnOrders:
      note.statut:
        - À faire
        - En cours
        - Fait
    swimlaneOrders:
      "note.statut\x1fnote.etape":
        - 1 - Procédure de test
        - 2 - Fabrication
        - 3 - Soudure
        - 4 - Code
        - 5 - Tests
        - 6 - Carte V2
  - type: kanban-view
    name: Par personne
    order:
      - date
      - duree
    groupByProperty: note.statut
    swimlaneByProperty: note.qui
    columnOrders:
      note.statut:
        - À faire
        - En cours
        - Fait
    swimlaneOrders:
      "note.statut\x1fnote.qui":
        - Rafaël
        - Jules
        - Les deux
  - type: table
    name: Liste
    order:
      - date
      - file.name
      - qui
      - duree
      - statut
      - etape
    sort:
      - property: note.date
        direction: ASC
